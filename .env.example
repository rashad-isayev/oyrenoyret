# Copy this file to `.env` for local development. Never commit `.env`.

# Database
DATABASE_URL=
# Optional: if your host provides a Prisma-specific variable name (e.g. some Vercel setups)
DATABASE_PRISMA_DATABASE_URL=

# Auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# Required in production. Use a different random value for each secret.
GUARDIAN_VERIFICATION_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Development only: issued codes and reset links are printed to the local
# server terminal. Set to 1 to skip provider delivery as well.
EMAIL_DEV_LOG_ONLY=0

# Cloudflare R2 (uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep this bucket private. Objects are served only through authorized app routes.
R2_PRIVATE_BUCKET=
# Optional
R2_ENDPOINT=
R2_DISCUSSIONS_PREFIX=
R2_PRESIGN_TTL_SECONDS=300

# Cron endpoints (required in production)
CRON_SECRET=

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required outside Vercel: choose the client-IP header overwritten by your trusted proxy.
TRUSTED_PROXY_IP_HEADER=

# Production database TLS cannot be disabled.
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
# Accepted production values: require, verify-ca, or verify-full.
PG_SSLMODE=verify-full
