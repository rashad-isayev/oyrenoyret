{
  "name": "oyrenoyret.org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --webpack",
    "predev:turbo": "prisma generate",
    "dev:turbo": "next dev",
    "predev:webpack": "prisma generate",
    "dev:webpack": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "prestart": "node scripts/validate-env.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:docker:up": "node scripts/setup-local-database.mjs && docker compose up -d --wait postgres",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:reset-email-verification": "node scripts/reset-email-verification.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:doctor": "node scripts/admin-doctor.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:scan:history": "node scripts/security-scan.mjs --history=HEAD",
    "security:audit": "npm audit --audit-level=low",
    "security:smoke": "node scripts/security-http-smoke.mjs",
    "test:security": "node --test --experimental-strip-types tests/security/*.test.ts",
    "env:check": "node scripts/validate-env.mjs",
    "typecheck": "tsc --noEmit",
    "ui:check": "node scripts/validate-ui-controls.mjs",
    "i18n:check": "node --experimental-strip-types scripts/validate-i18n.mjs",
    "db:backup:local": "node scripts/backup-database.mjs",
    "db:verify-backup": "node scripts/verify-database-backup.mjs",
    "readiness:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@swc/helpers": "0.5.17",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.1",
    "@tiptap/extension-superscript": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "entities": "^8.0.0",
    "framer-motion": "^12.42.2",
    "isomorphic-dompurify": "^3.19.0",
    "next": "16.2.11",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "$brace-expansion",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  }
}
