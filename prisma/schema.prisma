// Prisma Schema
// Database schema for the Oyrenoyret.org application
// All models use UUID primary keys and include soft-delete support

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARENT
  ADMIN
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum AccountOwnerType {
  SELF
  GUARDIAN
}

enum UserReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum UserReportReason {
  SPAM
  HARASSMENT
  CHEATING
  IMPERSONATION
  OTHER
}

enum ReportTargetType {
  PROFILE
  DISCUSSION
  DISCUSSION_REPLY
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum ModerationTargetType {
  USER
  DISCUSSION
  DISCUSSION_REPLY
}

enum ModerationActionType {
  SUSPEND
  UNSUSPEND
  SUSPENSION_EXPIRED
  BAN
  UNBAN
  REMOVE_CONTENT
}

model ContactMessage {
  id        String  @id @default(uuid())
  userId    String?
  name      String?
  email     String
  subject   String?
  message   String
  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

model User {
  id               String     @id @default(uuid())
  publicId         String?    @unique
  email            String     @unique
  passwordHash     String? // Nullable for OAuth users
  role             UserRole   @default(STUDENT)
  status           UserStatus @default(INACTIVE) // Moderation/lifecycle state; onboarding readiness is tracked separately
  emailVerifiedAt  DateTime? // User email verification timestamp (required for write actions)
  suspensionUntil  DateTime?
  suspensionReason String?    @db.Text
  bannedAt         DateTime?
  banReason        String?    @db.Text
  dateOfBirth      DateTime? // Required for minors, nullable for parents/admins
  firstName        String?
  lastName         String?
  // Avatar color/theme variant. Maps to public `/avatar-<variant>.png`.
  avatarVariant    String     @default("regular")
  grade            String? // Student grade: 5, 6, 7, 8, 9, 10, 11

  // Registration flow tracking
  registrationStep        Int               @default(1) // Compatibility/analytics only; milestone timestamps are authoritative
  learningMotivation      String?
  weeklyLearningGoal      String?
  declaredAge             Int?
  accountOwnerType        AccountOwnerType?
  onboardingStartedAt     DateTime?
  registrationCompletedAt DateTime?
  guidelinesAcceptedAt    DateTime?
  guidelinesVersion       String?
  parentEmail             String? // Parent/guardian email (stored but not trusted until verified)
  parentFirstName         String?
  parentLastName          String?
  tutorialCompletedAt     DateTime? // When the onboarding tutorial is completed
  tutorialSkippedAt       DateTime? // When the optional product tour is explicitly skipped
  tutorialStep            Int               @default(0) // Last completed product-tour step

  // Relations
  parentalConsents            ParentalConsent[]
  registrationVerifications   RegistrationVerification[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  authSessions                AuthSession[]
  discussions                 Discussion[]
  discussionsRemoved          Discussion[]                 @relation("DiscussionRemovedBy")
  discussionReplies           DiscussionReply[]
  discussionRepliesRemoved    DiscussionReply[]            @relation("DiscussionReplyRemovedBy")
  discussionParticipantStates DiscussionParticipantState[]
  contactMessages             ContactMessage[]
  reportsMade                 UserReport[]                 @relation("UserReportsReporter")
  reportsReceived             UserReport[]                 @relation("UserReportsReported")
  reportsResolved             UserReport[]                 @relation("UserReportsResolvedBy")
  moderationActions           ModerationAction[]           @relation("ModerationActor")
  moderationActionsTargeted   ModerationAction[]           @relation("ModerationTargetUser")

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete support

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([parentEmail])
  @@index([emailVerifiedAt])
  @@index([registrationStep])
  @@index([tutorialCompletedAt])
  @@index([tutorialSkippedAt])
  @@index([suspensionUntil])
  @@index([bannedAt])
}

model ModerationAction {
  id              String               @id @default(uuid())
  actorId         String?
  targetUserId    String?
  targetType      ModerationTargetType @default(USER)
  targetId        String?
  actionType      ModerationActionType
  reason          String               @db.Text
  durationSeconds Int?
  metadata        Json?

  actor      User? @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model UserReport {
  id             String           @id @default(uuid())
  reporterId     String
  reportedUserId String
  targetType     ReportTargetType @default(PROFILE)
  targetId       String?
  reason         UserReportReason
  details        String?          @db.Text
  contextUrl     String?
  status         UserReportStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?

  reporter     User  @relation("UserReportsReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("UserReportsReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy   User? @relation("UserReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([targetType])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model RegistrationVerification {
  id         String    @id @default(uuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  used       Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([used])
}

model ParentalConsent {
  id             String        @id @default(uuid())
  userId         String
  parentEmail    String
  status         ConsentStatus @default(PENDING)
  consentVersion String // Version of consent terms (e.g., "v1.0", "v2.1")
  grantedAt      DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime? // Optional expiration date

  // Relations
  user User @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentEmail])
  @@index([status])
  @@index([consentVersion])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // SHA-256(session token); raw token is never stored
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Discussion {
  id             String    @id @default(uuid())
  userId         String
  title          String
  content        String    @db.Text
  tags           String[]  @default([])
  lastActivityAt DateTime  @default(now()) // Updated when the room changes; used by configurable lifecycle policy
  archivedAt     DateTime? // Read-only after prolonged inactivity

  // Relations
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies           DiscussionReply[]            @relation("DiscussionReplies")
  participantStates DiscussionParticipantState[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  removedAt     DateTime?
  removedById   String?
  removedReason String?   @db.Text
  removedBy     User?     @relation("DiscussionRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, removedAt])
  @@index([tags], type: Gin)
  @@index([archivedAt])
  @@index([lastActivityAt])
  @@index([archivedAt, lastActivityAt])
  @@index([removedAt])
  @@index([removedById])
}

model DiscussionReply {
  id            String    @id @default(uuid())
  discussionId  String
  userId        String
  content       String    @db.Text
  removedAt     DateTime?
  removedById   String?
  removedReason String?   @db.Text

  // Relations
  discussion       Discussion                   @relation("DiscussionReplies", fields: [discussionId], references: [id], onDelete: Cascade)
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  removedBy        User?                        @relation("DiscussionReplyRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  readCursorStates DiscussionParticipantState[] @relation("DiscussionReadCursor")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discussionId])
  @@index([userId])
  @@index([userId, removedAt, discussionId])
  @@index([removedAt])
  @@index([removedById])
}

model DiscussionParticipantState {
  id              String    @id @default(uuid())
  discussionId    String
  userId          String
  lastReadReplyId String?
  lastReadAt      DateTime?
  lastSentAt      DateTime?

  discussion    Discussion       @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadReply DiscussionReply? @relation("DiscussionReadCursor", fields: [lastReadReplyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([discussionId, userId])
  @@index([userId, updatedAt])
  @@index([discussionId, lastReadAt])
  @@index([lastReadReplyId])
  @@index([lastSentAt])
}
